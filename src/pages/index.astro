---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { SITE, EMAIL, LINKEDIN, INSTAGRAM } from '../site.mjs';
const description = 'ORVUM is an AI-native retail operating system in development, designed to read buying, stock, clients and cash together and prepare decisions for approval.';
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE}/#organization`,
      name: 'ORVUM',
      url: `${SITE}/`,
      logo: { '@type': 'ImageObject', url: `${SITE}/site/brand/icon-512.png`, width: 512, height: 512 },
      description: 'ORVUM is an AI-native retail operating system in development for retailers and the brands they work with.',
      foundingLocation: { '@type': 'Place', address: { '@type': 'PostalAddress', addressCountry: 'CY' } },
      areaServed: 'Worldwide',
      email: EMAIL,
      founder: { '@id': `${SITE}/#founder` },
      sameAs: [LINKEDIN, INSTAGRAM],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: `${SITE}/`,
      name: 'ORVUM',
      inLanguage: 'en',
      publisher: { '@id': `${SITE}/#organization` },
    },
    {
      '@type': 'WebPage',
      '@id': `${SITE}/#webpage`,
      url: `${SITE}/`,
      name: 'ORVUM — AI Retail Operating System for Buying, Stock & Cash',
      description,
      inLanguage: 'en',
      isPartOf: { '@id': `${SITE}/#website` },
      about: { '@id': `${SITE}/#organization` },
    },
  ],
};
---
<Base
  title="ORVUM — AI Retail Operating System for Buying, Stock & Cash"
  description={description}
  canonical={`${SITE}/`}
  robots="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  ogTitle="ORVUM — AI Retail Operating System for Buying, Stock & Cash"
  ogDescription={description}
  jsonld={jsonld}
  css={['/site/v5/orvum-public.css', '/site/v5/orvum-public-2.css', '/site/v5/orvum-public-3.css']}
>
<Fragment slot="head"><style is:inline id="orvum-laptop-fit">
  /* owner, 22 Nov: laptop windows show the page below the hero at 86%, in the same column as the menu */
  @media (min-width: 1100px) and (max-width: 1919px) and (max-height: 1050px) {
    main, .pfoot { zoom: .86; }
    main .wrap, .pfoot .wrap { max-width: calc(1240px / .86); padding: 0 calc(28px / .86); }
    .sec { padding: clamp(56px, 8vh, 88px) 0; }
  }
</style></Fragment>
<a class="skip" href="#decision">Skip to content</a>

<h1 class="vh">ORVUM — The Intelligence Core for Retail</h1>
<p class="vh">ORVUM is an AI-native retail operating system in development, designed for retailers and the brands they work with.</p>

<!-- The first screen is the production hero; every change to it is listed in build.mjs. -->
<div class="hero-frame" id="top">
  <iframe id="hero" src="/hero" title="ORVUM — The Intelligence Core for Retail" allow="fullscreen"></iframe>
</div>

