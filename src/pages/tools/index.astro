---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Crumbs from '../../components/Crumbs.astro';
import { SITE } from '../../site.mjs';
import { TOOLS } from '../../learn.mjs';
const url = `${SITE}/tools`;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${url}#webpage`,
      url,
      name: 'Free retail calculators',
      inLanguage: 'en',
      isPartOf: { '@id': `${SITE}/#website` },
      hasPart: TOOLS.map((t) => ({ '@id': `${SITE}/tools/${t.slug}#app` })),
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
          { '@type': 'ListItem', position: 2, name: 'Tools', item: url },
        ],
      },
    },
  ],
};
---
<Base title="Free Retail Calculators for Buyers and Owners — ORVUM"
  description="Free calculators for retail buying and inventory: open-to-buy and sell-through rate, with formulas and worked examples. Built by ORVUM."
  canonical={url} jsonld={jsonld}
  css={['/site/v5/orvum-public.css', '/site/v5/orvum-public-2.css', '/site/css/pages.css', '/site/css/learn.css']}>
<a class="skip" href="#main">Skip to content</a>
<Nav current="/tools" />
<main id="main">
<section class="sec dark page-top" aria-labelledby="h1">
  <div class="wrap">
    <Crumbs items={[{ href: '/', label: 'Home' }, { label: 'Tools' }]} />
    <h1 id="h1">Free retail calculators</h1>
    <p class="lead">Two calculators for the numbers behind every buying decision. They run in your browser: nothing you enter is sent or saved.</p>
  </div>
</section>
<section class="sec light" aria-labelledby="tools-h">
  <div class="wrap">
    <h2 id="tools-h" class="vh">Calculators</h2>
    <ul class="cards">{TOOLS.map((t) => <li><a href={`/tools/${t.slug}`}><h3>{t.name}</h3><p>{t.short}</p></a></li>)}</ul>
    <p class="note">Definitions of the terms behind them are in the <a href="/glossary">retail metrics glossary</a>.</p>
  </div>
</section>
</main>
<Footer />
</Base>
