---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Crumbs from '../../components/Crumbs.astro';
import { SITE } from '../../site.mjs';
import { TOOLS } from '../../learn.mjs';
const tool = TOOLS[0];
const url = `${SITE}/tools/${tool.slug}`;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${url}#webpage`,
      url,
      name: tool.title,
      inLanguage: 'en',
      isPartOf: { '@id': `${SITE}/#website` },
      mainEntity: { '@id': `${url}#app` },
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
          { '@type': 'ListItem', position: 2, name: 'Tools', item: `${SITE}/tools` },
          { '@type': 'ListItem', position: 3, name: tool.name, item: url },
        ],
      },
    },
    {
      '@type': 'WebApplication',
      '@id': `${url}#app`,
      name: tool.name,
      url,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      description: tool.short,
      publisher: { '@id': `${SITE}/#organization` },
    },
  ],
};
const fields = [
  ['sales', 'Planned sales', 'Sales you plan for the period.'],
  ['red', 'Planned reductions', 'Markdowns, discounts and shrink.'],
  ['eop', 'Planned end-of-period inventory', 'Stock you want to hold when the period ends.'],
  ['bop', 'Beginning-of-period inventory', 'Stock at the start of the period.'],
  ['oo', 'On order for the period', 'Orders already placed that arrive in this period.'],
];
---
<Base title={tool.title} description={tool.description} canonical={url} jsonld={jsonld}
  css={['/site/v5/orvum-public.css', '/site/v5/orvum-public-2.css', '/site/css/pages.css', '/site/css/learn.css']}>
<a class="skip" href="#main">Skip to content</a>
<Nav current="/tools" />
<main id="main">
<section class="sec dark page-top" aria-labelledby="h1">
  <div class="wrap">
    <Crumbs items={[{ href: '/', label: 'Home' }, { href: '/tools', label: 'Tools' }, { label: tool.name }]} />
    <h1 id="h1">Open-to-buy calculator</h1>
    <p class="lead">Open-to-buy (OTB) is the amount you can still buy for a period without overstocking. Enter your plan below to calculate it for one month or for a whole season.</p>
  </div>
</section>

<section class="sec light" aria-label="Calculator">
  <div class="wrap">
    <div class="calc" id="otb">
      <form novalidate>
        <div class="calc-opts">
          <fieldset><legend>Period</legend>
            <label><input type="radio" name="mode" value="one" checked> One period</label>
            <label><input type="radio" name="mode" value="season"> Season by month</label>
          </fieldset>
          <p data-months hidden><label for="otb-months">Months</label> <select id="otb-months">{[2, 3, 4, 5, 6].map((n) => <option value={n} selected={n === 3}>{n}</option>)}</select></p>
          <fieldset><legend>Basis</legend>
            <label><input type="radio" name="basis" value="retail" checked> At retail</label>
            <label><input type="radio" name="basis" value="cost"> At cost</label>
          </fieldset>
          <p><label for="otb-cur">Currency</label> <select id="otb-cur"><option value="EUR" selected>EUR €</option><option value="USD">USD $</option><option value="GBP">GBP £</option></select></p>
        </div>
        <p class="hint">Enter every amount <span data-basis>at retail</span>, in the same currency. The currency only changes the symbol; nothing is converted.</p>
        <div class="grid" data-single>
          {fields.map(([k, l, h]) => <><label for={`otb-${k}`}>{l} <span class="hint">{h}</span></label><input id={`otb-${k}`} inputmode="decimal" autocomplete="off" /></>)}
        </div>
        <div data-season hidden></div>
        <p class="calc-go"><button type="submit" class="pbtn primary">Calculate</button> <button type="button" class="pbtn" data-copy hidden>Copy result</button></p>
      </form>
      <div class="calc-out" aria-live="polite"></div>
      <noscript><p class="calc-msg">The calculator needs JavaScript. The formula and a worked example are below.</p></noscript>
      <p class="note">Runs in your browser: nothing you enter is sent or saved.</p>
    </div>
  </div>
</section>

<section class="sec light" aria-labelledby="how-h" style="padding-top:0">
  <div class="wrap prose">
    <h2 id="how-h">How to calculate open-to-buy</h2>
    <p class="formula">Planned purchases = planned sales + planned reductions + planned end-of-period inventory − beginning-of-period inventory.<br>Open-to-buy = planned purchases − orders already placed for the period.</p>
    <p>Use one basis for every input: all at retail value or all at cost.</p>
    <p>Open-to-buy is a merchandise plan, not a cash budget: it does not check supplier payment dates, cash on hand or credit limits, and it is not an approval to spend.</p>
    <h2>Example <span class="tag">illustrative</span></h2>
    <p>A boutique plans €100,000 of sales in March, €10,000 of markdowns and wants to end the month with €250,000 of stock. It starts March with €220,000 of stock and has €60,000 of brand orders arriving in March.</p>
    <p class="formula">Planned purchases = 100,000 + 10,000 + 250,000 − 220,000 = €140,000.<br>Open-to-buy = 140,000 − 60,000 = €80,000.</p>
    <h2>Why open-to-buy matters in multi-brand retail</h2>
    <p>A multi-brand boutique commits most of its budget months ahead, brand by brand, at seasonal order appointments. Without an open-to-buy that is updated as sales and deliveries come in, it is easy to over-commit to one brand and run out of budget for re-orders on the pieces that actually sell.</p>
    <h2>Questions</h2>
    <h3>What does a negative open-to-buy mean?</h3>
    <p>You have already committed more than your plan allows for the period. Options are to cancel or delay orders, raise the sales plan only if it is realistic, or accept a higher end-of-period stock.</p>
    <h3>Should I calculate OTB at retail or at cost?</h3>
    <p>Either works if every input uses the same basis. Retail value is common in planning; cost is closer to cash.</p>
    <h3>How often should open-to-buy be updated?</h3>
    <p>At least monthly, and weekly during the selling season, as actual sales, markdowns and deliveries replace the plan.</p>
    <p class="rel-line">Related: <a href="/glossary/open-to-buy">Open-to-buy explained</a> · <a href="/tools/sell-through-calculator">Sell-through calculator</a></p>
    <p class="note">ORVUM is an AI-native retail operating system in development, designed to keep open-to-buy current from live sales, stock and orders. <a href="/platform">See the platform →</a></p>
  </div>
</section>
</main>
<Footer />
<script is:inline src="/js/calc-otb.js" defer></script>
</Base>
