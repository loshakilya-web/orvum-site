---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Crumbs from '../../components/Crumbs.astro';
import { SITE } from '../../site.mjs';
import { TERMS, TOOLS } from '../../learn.mjs';
const url = `${SITE}/glossary`;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${url}#webpage`,
      url,
      name: 'Retail Metrics Glossary',
      inLanguage: 'en',
      isPartOf: { '@id': `${SITE}/#website` },
      mainEntity: { '@id': `${url}#set` },
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
          { '@type': 'ListItem', position: 2, name: 'Glossary', item: url },
        ],
      },
    },
    {
      '@type': 'DefinedTermSet',
      '@id': `${url}#set`,
      name: 'Retail buying and inventory metrics',
      url,
      publisher: { '@id': `${SITE}/#organization` },
      hasDefinedTerm: TERMS.map((t) => ({ '@id': `${SITE}/glossary/${t.slug}#term` })),
    },
  ],
};
---
<Base title="Retail Metrics Glossary — Buying and Inventory Terms"
  description="Clear definitions of retail buying and inventory metrics: open-to-buy, sell-through, GMROI, weeks of supply, inventory turnover, clienteling."
  canonical={url} jsonld={jsonld}
  css={['/site/v5/orvum-public.css', '/site/v5/orvum-public-2.css', '/site/css/pages.css', '/site/css/learn.css']}>
<a class="skip" href="#main">Skip to content</a>
<Nav current="/glossary" />
<main id="main">
<section class="sec dark page-top" aria-labelledby="h1">
  <div class="wrap">
    <Crumbs items={[{ href: '/', label: 'Home' }, { label: 'Glossary' }]} />
    <h1 id="h1">Retail metrics glossary</h1>
    <p class="lead">Plain definitions of the measures that decide a retail season — with the formula, a worked example and how each one is used.</p>
  </div>
</section>
<section class="sec light" aria-labelledby="terms-h">
  <div class="wrap">
    <h2 id="terms-h" class="vh">Terms</h2>
    <ul class="cards">{TERMS.map((t) => <li><a href={`/glossary/${t.slug}`}><h3>{t.name}</h3><p>{t.definition}</p></a></li>)}</ul>
    <p class="note">Calculators: {TOOLS.map((x, i) => <>{i > 0 && ' · '}<a href={`/tools/${x.slug}`}>{x.name}</a></>)}</p>
  </div>
</section>
</main>
<Footer />
</Base>
